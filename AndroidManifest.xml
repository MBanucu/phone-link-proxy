<?xml version="1.0" encoding="utf-8"?>
<!--
  Control surface: `adb shell am start-foreground-service` only.

  The service is exported and guarded by android.permission.DUMP, which the
  shell user holds and ordinary apps do not, so a wired or wireless adb session
  can start and stop the listener without the phone being unlocked, and nothing
  else on the network can.

  The components are named in full rather than as `.Name`, because build.sh
  relinks this manifest under a second package (`org.phonelink.proxy.test`) for
  the build the live harness installs: a relative name would follow the package
  and point at a class that does not exist, while a full one keeps pointing at
  the code this manifest was written for. The class package and the application
  id are then two different things, which is also why a component is addressed
  as `org.phonelink.proxy.test/org.phonelink.proxy.ProxyService`.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.phonelink.proxy"
    android:versionCode="0"
    android:versionName="0.0.0">
    <!-- The two above are a template: android/build.sh stamps the project's
         version (android/version, kept in step with the flake's `version` by
         `nix flake check`) into a copy at build time, so a phone can say which
         release it runs instead of 0.1.0 forever. -->

    <uses-sdk
        android:minSdkVersion="29"
        android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- requestNetwork(), as opposed to registerNetworkCallback(), counts as a
         change: without this the first cellular request throws SecurityException. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
<uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Asked for from the panel: without it Android refuses to restart the
         proxy at boot. Requesting the exemption needs this permission. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- The SSID of the current Wi-Fi is redacted without location permission
         and location switched on; the uplink predicate matches on it. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- A tile click is user interaction, which is enough to start a foreground
         service, but Android still rejects the location service type unless the
         app may hold location while it is in the background. Grant "Allow all
         the time"; without it the tile starts the proxy with the SSID hidden
         and the listener stays shut. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Wireless debugging is switched off by the reboot on this phone, and the
         port the scripts need only exists while it is on. WRITE_SECURE_SETTINGS
         is a development permission, so `adb shell pm grant` (done by
         phone-proxy-install) hands it over; AdbWireless then turns the setting
         back on whenever the phone joins the configured SSID. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" /><application
android:directBootAware="true"
android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true">

        <activity
            android:name="org.phonelink.proxy.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- specialUse only. Adding `location` here makes Android 15 reject the
             start while the user is still locked ("Starting FGS with type
             location ... must be in the eligible state"): the location grant
             lives in credential storage and cannot be used pre-unlock, so the
             boot hand-off died. The location *permission* is still declared —
             it is what makes the SSID readable — it just must not be part of
             the foreground service type. -->
        <service
android:name="org.phonelink.proxy.ProxyService"
android:exported="true"
android:directBootAware="true"
android:foregroundServiceType="specialUse"
android:permission="android.permission.DUMP">
<property
android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
android:value="socks proxy listener for the paired laptop" />
</service>

        <!-- Quick Settings tile: the system binds it, so the permission is the
             contract rather than a gate we apply. -->
        <service
            android:name="org.phonelink.proxy.ProxyTile"
            android:exported="true"
            android:icon="@drawable/ic_stat_proxy"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name="org.phonelink.proxy.BootReceiver"
            android:exported="true"
            android:directBootAware="true"><intent-filter>
<action android:name="android.intent.action.BOOT_COMPLETED" />
<!-- Direct boot: the vendor allowlists the app, so this arrives before
     the first unlock, and the listener can come up with it. -->
<action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
</intent-filter>
        </receiver>
    </application>
</manifest>
